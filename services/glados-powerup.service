[Unit]
Description=GLaDOS Power-Up Sound
After=sound.target
Wants=sound.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'until aplay -l 2>/dev/null | grep -q "USB PnP Sound Device"; do sleep 0.5; done; aplay -D plughw:CARD=Device /opt/glados/sounds/powerup01.wav'

[Install]
WantedBy=sound.target
